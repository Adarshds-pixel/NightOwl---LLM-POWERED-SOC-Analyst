# Build context is the REPO ROOT (see docker-compose.yml's `build.context: .`),
# not backend/ -- app/core/config.py, app/mitre/loader.py, and
# app/rag/chroma_client.py all resolve paths via
# `Path(__file__).resolve().parents[3]` (repo root, 3 levels above app/), so
# this image mirrors the same backend/app/... nesting rather than flattening it.

# ---- builder: install deps into a venv, kept out of the runtime stage's history ----
FROM python:3.14-slim AS builder
WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY backend/requirements.txt ./backend/requirements.txt
# PIP_EXTRA_ARGS lets a build behind a TLS-intercepting corporate proxy pass
# e.g. "--trusted-host pypi.org --trusted-host files.pythonhosted.org"
# without weakening every other build.
ARG PIP_EXTRA_ARGS=""
# CPU-only torch first: sentence-transformers would otherwise pull the CUDA
# build and ~3 GB of NVIDIA libraries the container never uses.
RUN pip install --no-cache-dir ${PIP_EXTRA_ARGS} torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir ${PIP_EXTRA_ARGS} -r backend/requirements.txt

# ---- runtime ----
FROM python:3.14-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production
RUN useradd --create-home --uid 1000 appuser
WORKDIR /app
COPY --from=builder --chown=appuser:appuser /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY --chown=appuser:appuser backend/app ./backend/app
COPY --chown=appuser:appuser backend/alembic ./backend/alembic
COPY --chown=appuser:appuser backend/alembic.ini ./backend/alembic.ini
# Demo Mode replays real, already-detected captures (api/routes_demo.py);
# without them in the image /demo/fixtures answered 503.
COPY --chown=appuser:appuser backend/sample_logs/real_world_fixtures/detected ./backend/sample_logs/real_world_fixtures/detected
# The catalog Demo Mode lists fixtures from (generated by build_failure_matrix.py).
COPY --chown=appuser:appuser backend/scripts/failure_matrix.json ./backend/scripts/failure_matrix.json
# Held-out evaluation of the ML anomaly layer, shown in Settings -> ML model (api/routes_ml.py).
COPY --chown=appuser:appuser backend/scripts/ml_eval_results.json ./backend/scripts/ml_eval_results.json
# Knowledge-base sources and builder; the built vector store lives on a named
# volume (docker-compose.yml).
COPY --chown=appuser:appuser ai/tools ./ai/tools
COPY --chown=appuser:appuser ai/knowledge_base ./ai/knowledge_base
COPY --chown=appuser:appuser backend/docker-entrypoint.sh ./backend/docker-entrypoint.sh
RUN sed -i 's/\r$//' ./backend/docker-entrypoint.sh && chmod +x ./backend/docker-entrypoint.sh \
    && mkdir -p /app/ai/vector_store /home/appuser/.cache \
    && chown -R appuser:appuser /app/ai /home/appuser/.cache
USER appuser
WORKDIR /app/backend
EXPOSE 8000
# The first start builds the knowledge base before uvicorn listens (~3 min on
# CPU), so the start period is generous; the container still turns healthy on
# the first passing check, so later restarts are not slowed down.
HEALTHCHECK --interval=15s --timeout=5s --start-period=600s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=4).status == 200 else 1)"
ENTRYPOINT ["./docker-entrypoint.sh"]
