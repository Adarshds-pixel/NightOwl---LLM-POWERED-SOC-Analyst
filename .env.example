# Copy this file to .env and adjust values as needed. Never commit the real .env.

# local | production. Anything other than local turns on Secure cookies, hides
# /docs, and makes startup refuse an empty SESSION_SECRET_KEY / ADMIN_PASSWORD_HASH.
# docker-compose.yml defaults the backend container to production.
APP_ENV=local

# Postgres (used by docker-compose's db service and by DATABASE_URL below)
POSTGRES_USER=nightowl
# Required by docker-compose.yml -- choose a real password for any shared machine.
POSTGRES_PASSWORD=nightowl
POSTGRES_DB=nightowl

# SQLAlchemy connection string the backend actually reads
# Port 5433 (not the Postgres default 5432) — see docker-compose.yml comment.
DATABASE_URL=postgresql+psycopg2://nightowl:nightowl@localhost:5433/nightowl

# LLM provider (Pair 2 / Day 7+) — Groq, exclusively (free-tier only). This
# project previously also supported Gemini as an alternate provider, removed
# 2026-09-06 once Gemini's free tier proved structurally unreliable (a hard
# 20-req/day quota plus separate Google-side server overload, both
# structural to that free tier, not something fixable here). Get a free
# Groq key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM call robustness (Pair 2 / Day 12)
# Per-request timeout in seconds for the LLM provider call.
LLM_TIMEOUT_SECONDS=30
# Cache llm_client.generate() responses in memory, keyed on exact prompt
# content -- a testing aid for repeated manual runs against a tight
# free-tier quota. Leave false for normal/production use.
LLM_CACHE_ENABLED=false

# Production hardening (Pair 2 / Day 13) -- always-on response cache for
# explain()/chat() results, keyed on incident id (+ message, for chat).
# Distinct from LLM_CACHE_ENABLED above (opt-in, exact-prompt-keyed testing
# aid); this one is meant to stay on in normal/production use.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=900

# Production hardening (Pair 1 / Day 13)
# Optional credential for headless clients (scripts, Postman): a request with
# `X-API-Key: <value>` is accepted in place of a login session. Empty = off.
# Never give this to the browser frontend -- a key in a JS bundle is public.
# See backend/app/core/auth.py.
API_KEY=
# In-memory rate limit, requests/minute per client. <= 0 disables it.
# See backend/app/core/rate_limit.py. /health is exempt (liveness probe).
#
# 300, not 60: one dashboard paint legitimately costs about a dozen requests,
# so the old ceiling (one token per second) throttled ordinary use.
RATE_LIMIT_PER_MINUTE=300
# Comma-separated IP addresses or CIDR networks allowed to set X-Forwarded-For
# for rate-limit identity resolution (e.g. "10.0.0.0/8" for an internal load
# balancer subnet, or the exact IP of a single reverse proxy). Empty by
# default (the safe default) -- with nothing configured, X-Forwarded-For is
# never trusted and every client is rate-limited by its direct peer IP,
# regardless of what headers it sends. Only set this if NightOwl sits behind
# a real reverse proxy/load balancer; setting it when there is no proxy in
# front of the app lets any client spoof this header to evade or collapse
# the rate limiter. See backend/app/core/rate_limit.py::get_client_ip().
TRUSTED_PROXIES=

# Frontend scaffold (Pair 1 / Day 14) -- origins allowed to call this API
# from a browser (comma-separated). Defaults cover the Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin login (single admin, no registration -- see backend/app/api/routes_auth.py).
# Both empty by default: with no password hash set, login can never succeed,
# and the app is not usable behind the auth-gated routes until you set these.
ADMIN_USERNAME=admin
# A bcrypt hash of the real admin password, never the plaintext password
# itself. Generate one with:
#   backend/venv/Scripts/python.exe -c "import bcrypt; print(bcrypt.hashpw(b'your-password-here', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Signs the session cookie (Starlette SessionMiddleware). Generate a random
# value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Treat this like any other credential -- if it leaks, every existing
# session cookie can be forged.
SESSION_SECRET_KEY=
# Seconds before a login session expires and requires a fresh login.
SESSION_MAX_AGE_SECONDS=43200
# Failed-login attempts allowed per minute per client IP, on POST
# /auth/login specifically -- deliberately much lower than
# RATE_LIMIT_PER_MINUTE above, which covers normal API traffic.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ML anomaly layer (see ML.md): advisory (default) | alert | off
ML_MODE=advisory

# Largest accepted EVTX upload, in bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600
