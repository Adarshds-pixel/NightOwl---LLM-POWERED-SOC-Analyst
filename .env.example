# Copy this file to .env and adjust values as needed. Never commit the real .env.

APP_ENV=local

# Postgres (used by docker-compose's db service and by DATABASE_URL below)
POSTGRES_USER=nightowl
POSTGRES_PASSWORD=nightowl
POSTGRES_DB=nightowl

# SQLAlchemy connection string the backend actually reads
# Port 5433 (not the Postgres default 5432) — see docker-compose.yml comment.
DATABASE_URL=postgresql+psycopg2://nightowl:nightowl@localhost:5433/nightowl

# LLM provider (Pair 2 / Day 7+) — free-tier only. Provider: Google Gemini (see docs/decisions.md).
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
# "gemini-flash-latest" tracks Google's current recommended free-tier Flash
# model instead of a dated snapshot that could be deprecated mid-project
# (see docs/decisions.md). Override to pin a specific version if ever needed.
LLM_MODEL=gemini-flash-latest

# Default provider as of 2026-08-25 (Pair 2 / Day 10 originally added this
# as a fallback, now promoted to default) — Gemini's free tier hit both a
# hard 20-req/day quota (429 RESOURCE_EXHAUSTED) and separate Google-side
# server overload (503/504), both structural to the free tier. Set
# LLM_PROVIDER=gemini above to switch back any time. Get a free Groq key at
# https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM call robustness (Pair 2 / Day 12)
# Per-request timeout in seconds for the LLM provider call.
LLM_TIMEOUT_SECONDS=30
# Cache llm_client.generate() responses in memory, keyed on exact prompt
# content -- a testing aid for repeated manual runs against a tight
# free-tier quota. Leave false for normal/production use.
LLM_CACHE_ENABLED=false

# Production hardening (Pair 2 / Day 13) -- always-on response cache for
# explain()/chat() results, keyed on incident id (+ message, for chat).
# Distinct from LLM_CACHE_ENABLED above (opt-in, exact-prompt-keyed testing
# aid); this one is meant to stay on in normal/production use.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=900

# Production hardening (Pair 1 / Day 13)
# Shared-secret header auth -- send as `X-API-Key: <value>`. Empty = auth
# disabled (default). See backend/app/core/auth.py.
API_KEY=
# In-memory rate limit, requests/minute per client. <= 0 disables it.
# See backend/app/core/rate_limit.py. /health is exempt (liveness probe).
#
# 300, not 60: one dashboard paint legitimately costs about a dozen requests,
# so the old ceiling (one token per second) throttled ordinary use.
RATE_LIMIT_PER_MINUTE=300

# Frontend scaffold (Pair 1 / Day 14) -- origins allowed to call this API
# from a browser (comma-separated). Defaults cover the Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
