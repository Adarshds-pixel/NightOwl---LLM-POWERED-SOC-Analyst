# Copy this file to .env and adjust values as needed. Never commit the real .env.

APP_ENV=local

# Postgres (used by docker-compose's db service and by DATABASE_URL below)
POSTGRES_USER=nightowl
POSTGRES_PASSWORD=nightowl
POSTGRES_DB=nightowl

# SQLAlchemy connection string the backend actually reads
# Port 5433 (not the Postgres default 5432) — see docker-compose.yml comment.
DATABASE_URL=postgresql+psycopg2://nightowl:nightowl@localhost:5433/nightowl

# LLM provider (Pair 2 / Day 7+) — free-tier only. Provider: Google Gemini (see docs/decisions.md).
# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
# "gemini-flash-latest" tracks Google's current recommended free-tier Flash
# model instead of a dated snapshot that could be deprecated mid-project
# (see docs/decisions.md). Override to pin a specific version if ever needed.
LLM_MODEL=gemini-flash-latest

# Alternate free-tier provider (Pair 2 / Day 10) — set LLM_PROVIDER=groq to
# switch app/rag/llm_client.py over to Groq (e.g. when Gemini's 20 req/day
# cap is a problem, like the Day 10 hallucination spot-check's 10 explain()
# calls = 20 requests). Get a free key at https://console.groq.com/keys
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per-call network timeout (seconds) for the LLM provider. Without this, a
# stalled network call (e.g. a proxy silently dropping the response) blocks
# the request thread indefinitely instead of failing into the existing
# retry/LLMProviderError path. See backend/app/rag/llm_client.py.
LLM_TIMEOUT_SECONDS=30

# Production hardening (Day 13)
# Shared-secret header auth -- send as `X-API-Key: <value>`. Empty = auth
# disabled (default). See backend/app/core/auth.py.
API_KEY=
# In-memory rate limit, requests/minute per client. <= 0 disables it.
# See backend/app/core/rate_limit.py.
RATE_LIMIT_PER_MINUTE=60
