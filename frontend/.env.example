# Copy relevant values into a git-ignored .env.local to override locally.
# Never commit real per-developer values (Vite auto-ignores *.local).

# Backend base URL. Matches docs/postman/NightOwl.postman_environment.json's
# base_url default.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Shared-secret header auth (see backend/app/core/auth.py). Empty = disabled,
# same convention as the backend's own API_KEY -- only set this if the
# backend you're pointing at has API_KEY configured.
VITE_API_KEY=
