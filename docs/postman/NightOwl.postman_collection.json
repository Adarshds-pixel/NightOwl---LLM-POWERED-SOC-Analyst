{
  "info": {
    "name": "NightOwl API",
    "description": "Every NightOwl endpoint. Run Auth > Login first (set admin_username/admin_password in the environment); Postman keeps the session cookie. Alternatively set api_key when the server has API_KEY configured. A collection-level pre-request script adds the X-NightOwl-Request CSRF header that every POST/PATCH needs, and X-API-Key when api_key is set. See docs/DOCUMENTATION.md section 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-NightOwl-Request', value: '1' });",
          "const apiKey = pm.variables.get('api_key');",
          "if (apiKey) { pm.request.headers.upsert({ key: 'X-API-Key', value: apiKey }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health & status",
      "item": [
        {
          "name": "Health (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness only; no auth."
          },
          "response": []
        },
        {
          "name": "System status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/system/status",
              "host": [
