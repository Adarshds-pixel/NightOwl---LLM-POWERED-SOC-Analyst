              ],
              "path": [
                "system",
                "status"
              ]
            },
            "description": "Readiness of LLM key, knowledge base, rules, ML bundle, ATT&CK dataset."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Sets the session cookie. Postman keeps it for the following requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the server-side session; the old cookie stops working."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ingest",
      "item": [
        {
          "name": "Upload EVTX (synchronous)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Returns counts (checked/routine/unchecked), notices, telemetry profile, incident ids, ml_anomalies.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick an .evtx, e.g. backend/sample_logs/real_world_fixtures/detected/*.evtx"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload EVTX (background job)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ingest/async",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest",
                "async"
              ]
            },
            "description": "Returns 202 {job_id} at once; poll the job below. Use for large files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Pick an .evtx, e.g. backend/sample_logs/real_world_fixtures/detected/*.evtx"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload job status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ingest/jobs/{{job_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest",
                "jobs",
                "{{job_id}}"
              ]
            },
            "description": "reading -> analysing -> done | failed; the result is the same payload as the synchronous upload."
          },
          "response": []
        }
      ]
    },
